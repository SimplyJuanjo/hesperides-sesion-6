# Copia este archivo como .env y pon tus claves detrás del =, sin comillas. .env no se sube a git.
# Son las mismas de la sesión 5: si ya tienes ese .env, cópialo aquí.

# El LLM que redacta el brief. Con esta basta.
GROQ_API_KEY=

# Opcional, y muy recomendable: si Groq llega a su límite, el brief sigue con Gemini sin esperar.
GEMINI_API_KEY=

# Con las dos claves se empieza por Groq. Para empezar por Gemini: LLM_PROVEEDOR=gemini
# Para otro modelo del primer proveedor, por ejemplo: LLM_MODELO=openai/gpt-oss-20b
# LLM_PROVEEDOR=
# LLM_MODELO=

# Opcional, para extras/web.py: noticias de la web con Tavily. Gratis en https://app.tavily.com
TAVILY_API_KEY=
